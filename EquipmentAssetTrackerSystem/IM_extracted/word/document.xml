pPr><w:r w:rsidRPr="002B1955"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Function Name: </w:t></w:r><w:r w:rsidRPr="00D75768"><w:t>User Session Controller</w:t></w:r></w:p><w:p w14:paraId="3659F4EC" w14:textId="77777777" w:rsidR="002B1955" w:rsidRPr="00D75768" w:rsidRDefault="002B1955" w:rsidP="002B1955"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="24"/></w:numPr></w:pPr><w:r w:rsidRPr="002B1955"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Table Name: </w:t></w:r><w:r w:rsidRPr="00D75768"><w:t>users</w:t></w:r></w:p><w:p w14:paraId="3415CA0B" w14:textId="77777777" w:rsidR="002B1955" w:rsidRPr="002B1955" w:rsidRDefault="002B1955" w:rsidP="002B1955"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="24"/></w:numPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002B1955"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Column Names: </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00D75768"><w:t>user_id</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00D75768"><w:t xml:space="preserve">, username, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00D75768"><w:t>password_hash</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00D75768"><w:t xml:space="preserve">, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00D75768"><w:t>user_role</w:t></w:r><w:proofErr w:type="spellEnd"/></w:p><w:p w14:paraId="2BD5E639" w14:textId="77777777" w:rsidR="002B1955" w:rsidRPr="002B1955" w:rsidRDefault="00000000" w:rsidP="002B1955"><w:r><w:pict w14:anchorId="51B731E3"><v:rect id="_x0000_i1028" style="width:783.3pt;height:.75pt" o:hrpct="0" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="47EDDACB" w14:textId="77777777" w:rsidR="002B1955" w:rsidRPr="002B1955" w:rsidRDefault="002B1955" w:rsidP="002B1955"><w:r w:rsidRPr="002B1955"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Advantages:</w:t></w:r></w:p><w:p w14:paraId="653FAD7B" w14:textId="6A28B471" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">  Offline Reliability &amp; Privacy: </w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>Operates entirely locally, ensuring instant data access, zero latency, and complete data privacy without relying on an internet connection.</w:t></w:r></w:p><w:p w14:paraId="56EF226C" w14:textId="369F4312" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">  Zero-Configuration Deployment</w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>: The self-contained embedded database requires no complex IT setup or background servers (like MySQL), making it instantly ready to use.</w:t></w:r></w:p><w:p w14:paraId="2F0861CD" w14:textId="16DCD239" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">  Unified Lifecycle Tracking: </w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>Seamlessly connects inventory, borrowing, and repairs. For example, logging an item for maintenance automatically blocks it from being reserved.</w:t></w:r></w:p><w:p w14:paraId="6F9CC3C5" w14:textId="30798F87" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">  Automated Conflict Prevention</w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>: Built-in database logic automatically prevents double-bookings and blocks invalid chronological errors, such as a return date set before checkout.</w:t></w:r></w:p><w:p w14:paraId="6C0F55A6" w14:textId="4283F813" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">  Strict Accountability: </w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>Comprehensive audit logs, cost tracking, and permanent user assignments create a definitive, traceable chain of custody for every piece of hardware.</w:t></w:r></w:p><w:p w14:paraId="734B7745" w14:textId="77777777" w:rsidR="002B1955" w:rsidRPr="002B1955" w:rsidRDefault="00000000" w:rsidP="002B1955"><w:r><w:pict w14:anchorId="7C01A6BB"><v:rect id="_x0000_i1029" style="width:783.3pt;height:.75pt" o:hrpct="0" o:hralign="center" o:hrstd="t" o:hr="t" fillcolor="#a0a0a0" stroked="f"/></w:pict></w:r></w:p><w:p w14:paraId="312B86F5" w14:textId="77777777" w:rsidR="002B1955" w:rsidRPr="002B1955" w:rsidRDefault="002B1955" w:rsidP="002B1955"><w:r w:rsidRPr="002B1955"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Limitations:</w:t></w:r></w:p><w:p w14:paraId="3A94077D" w14:textId="202F49E9" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">  Hardware Dependency &amp; Backup Risk</w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>: Because the database is stored as a local file, a hard drive crash or physical damage to the host computer will result in total data loss unless manual file backups are regularly maintained</w:t></w:r><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="5BF0215F" w14:textId="3F25A57F" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">  No Remote Borrower Access</w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>: As an offline desktop application, borrowers cannot browse available inventory or submit reservation requests from their personal phones or laptops; all actions must be performed directly at the host workstation.</w:t></w:r></w:p><w:p w14:paraId="263D26FC" w14:textId="443EAE10" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">  Lack of External Notifications</w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>: The system relies strictly on internal dashboard visual cues to flag overdue items and maintenance alerts. It cannot automatically send SMS text messages or email reminders to borrowers or admins.</w:t></w:r></w:p><w:p w14:paraId="130D537D" w14:textId="33A88191" w:rsidR="00F325FB" w:rsidRPr="00F325FB" w:rsidRDefault="00F325FB" w:rsidP="00F325FB"><w:r w:rsidRPr="00F325FB"><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">  Multi-Desk Scalability</w:t></w:r><w:r w:rsidRPr="00F325FB"><w:t>: The embedded database is designed for a single-host environment. It cannot natively synchronize real-time data across multiple computers if the organization needs to expand to multiple simultaneous checkout desks.</w:t></w:r></w:p><w:p w14:paraId="192F83D0" w14:textId="77777777" w:rsidR="0050703B" w:rsidRPr="00F325FB" w:rsidRDefault="0050703B" w:rsidP="00EE61B9"/><w:sectPr w:rsidR="0050703B" w:rsidRPr="00F325FB"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>